# ===========================================================================
# AUC — every environment variable the application reads
#
# This is a reference, not a file the app loads. Nothing reads .env
# automatically. Settings reach the app one of three ways:
#
#   * Environment= lines in ~/.config/systemd/user/auc.service — how the
#     running service is configured, and where OLLAMA_MODEL and
#     AUC_BACKUP_DIR actually live. setup.sh preserves your edits there.
#   * Exported in the shell before `bash auc/run.sh`, for a one-off.
#   * Left unset, in which case the default below applies.
#
# Copy this to .env if you like keeping notes in one place — .env is
# gitignored. Never put a real key in .env.example; this file is committed.
# ===========================================================================


# ---------------------------------------------------------------------------
# Which model writes the summaries
#
# There is no single setting for this, and that is deliberate — any model in
# `ollama list` can be used, and you pick one in Settings. The first of these
# that is set wins:
#
#   1. The model chosen in Settings. The browser sends it with every
#      generation request, so in normal use this is what decides it. It is
#      stored in the browser, not on the server, so it does not travel with
#      the machine — you will re-pick it on the Spark.
#   2. AUC_SUMMARY_MODEL — summaries only, read in summary_builder.py.
#   3. OLLAMA_MODEL — everything else, and the last resort.
#
# If a summary ever comes out of a model you did not expect, check them in
# that order.
#
# Any replacement model must satisfy two things the generator depends on:
# it must honour Ollama's JSON-constrained output, or every section comes
# back "generation failed"; and it must quote verbatim, because every quote
# is checked against the comments routed to that sub-competency and a model
# that paraphrases has its quotes dropped. Do not relax that validation to
# accommodate a model — it is what keeps invented evidence out of a
# resident's record. Change the model instead.
# ---------------------------------------------------------------------------

# Where Ollama is listening.
OLLAMA_URL=http://localhost:11434

# The fallback generation model, used when the browser sends none.
OLLAMA_MODEL=qwen3:8b

# Overrides OLLAMA_MODEL for summary generation only. Usually unset.
# AUC_SUMMARY_MODEL=

# Ceiling on generated tokens per model call.
OLLAMA_MAX_TOKENS=2048


# ---------------------------------------------------------------------------
# The ACGME index
#
# Unlike the generation model, this one is NOT interchangeable. Embeddings
# from two different models are not comparable, so searching an index with a
# model other than the one that built it returns confident nonsense with no
# error at all.
#
# build_index.py stamps this name into the index and the app compares the
# two, so a mismatch is reported in Settings rather than silently tolerated.
# If you change it, rebuild the index in the same breath:
#
#   auc/backend/venv/bin/python auc/rag/build_index.py
#   systemctl --user restart auc     # it holds the index it opened at startup
# ---------------------------------------------------------------------------

AUC_EMBED_MODEL=qwen3-embedding:0.6b


# ---------------------------------------------------------------------------
# The NVIDIA Nemotron retrieval engine
#
# Which retrieval engine grounds the summaries is chosen in Settings, not
# here: NVIDIA Nemotron by default on a DGX Spark, Standard (the Ollama
# embedding model above) everywhere else. These say where the two Nemotron
# containers are and which models they serve. `bash auc/start-nemotron.sh`
# starts them on these ports, reachable from this machine only.
#
# NEVER point these at build.nvidia.com or any other hosted endpoint. That
# would send resident comments off this machine.
#
# Like AUC_EMBED_MODEL, the embedding model is stamped into its index. If you
# change it, rebuild in the same breath:
#
#   auc/backend/venv/bin/python auc/rag/build_index.py --engine nemotron
#
# The containers download their model weights the first time they start,
# which needs NGC_API_KEY (or HF_TOKEN) in the environment of the shell that
# runs start-nemotron.sh. Those are credentials: export them in that shell,
# never write them in this file.
# ---------------------------------------------------------------------------

AUC_NIM_EMBED_URL=http://localhost:8001
AUC_NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
AUC_NIM_RERANK_URL=http://localhost:8002
AUC_NIM_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2

# How many index entries the reranker chooses among, for a comment that
# matched no ontology keyword.
AUC_RERANK_CANDIDATES=10


# ---------------------------------------------------------------------------
# Where the app listens
#
# 0.0.0.0 means every network interface: anyone who can reach this machine
# on the network can reach the app. Fine on a trusted home network.
#
# On hospital wifi it is not — the login page, and the password typed into
# it, cross the network over plain HTTP where they can be read. There, set
# AUC_HOST=127.0.0.1 so only this machine can connect, and put Tailscale
# Serve in front of it for HTTPS:
#
#   tailscale serve --bg 3000
#
# Do not set 127.0.0.1 without a proxy in front, or you will lock yourself
# out of a headless machine.
# ---------------------------------------------------------------------------

AUC_HOST=0.0.0.0
AUC_PORT=3000


# ---------------------------------------------------------------------------
# Where the data lives
#
# auc.db, photos/ and logs/. Defaults to auc/data next to the code. Set it
# to put the data on a different disk. The database is not tracked in git,
# so whatever this points at is the only copy your backups protect.
# ---------------------------------------------------------------------------

# AUC_DATA_DIR=/home/you/resident-evaluations-auc/auc/data


# ---------------------------------------------------------------------------
# Backups
#
# Point AUC_BACKUP_DIR at a cloud-synced folder — your institutional
# OneDrive — so backups end up off this machine. Leave it empty to disable
# the automated backup. See auc/BACKUPS.md.
#
# Note what the backup does NOT include: data/logs/summary_validation.log.
# For a QI study that log is research provenance, so copy it deliberately.
# ---------------------------------------------------------------------------

AUC_BACKUP_DIR=
AUC_BACKUP_KEEP_DAYS=14


# ---------------------------------------------------------------------------
# MedHub API
#
# Unset until API documentation is obtained; CSV import works without it.
#
# MEDHUB_API_KEY IS A CREDENTIAL. Put the real value in the systemd unit or
# in .env — never here, and never in a commit.
# ---------------------------------------------------------------------------

MEDHUB_API_URL=
MEDHUB_API_KEY=
